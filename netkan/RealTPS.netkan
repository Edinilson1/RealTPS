{
    "identifier": "RealTPS",
    "name": "RealTPS",
    "abstract": "Completely reworks how heat shields work, aiming at greater realism: real thermal protection materials chosen in the editor and unlocked through the tech tree, with per-cell wear, breaches and shield failure.",
    "description": "Conflicts with Deadly Reentry until a compatibility patch exists: Deadly Reentry turns the ablator of the stock heat shields into its own heat-shield module, which RealTPS does not remove, so both mods end up handling the same part.",
    "author": "Edinilson",
    "$kref": "#/ckan/github/OWNER/REPOSITORY",
    "$vref": "#/ckan/ksp-avc",
    "license": "MIT",
    "release_status": "testing",
    "tags": [
        "plugin",
        "physics",
        "config"
    ],
    "depends": [
        { "name": "ModuleManager" },
        { "name": "B9PartSwitch" }
    ],
    "supports": [
        { "name": "CommunityTechTree" }
    ],
    "conflicts": [
        { "name": "DeadlyReentry" }
    ],
    "install": [
        {
            "find": "RealTPS",
            "install_to": "GameData"
        }
    ]
}
